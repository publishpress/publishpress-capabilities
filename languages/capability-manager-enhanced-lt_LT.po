msgstr ""
"Šis vaidmuo privalo išsaugoti skaitymo prieigą, kad nebūtų užblokuota "
"prieiga prie dashboard."

#: includes/mcp/role-operations.php:274
msgid "System, default and uneditable roles cannot be deleted."
msgstr "Sistemos, numatytųjų ir neredaguojamų vaidmenų ištrinti negalima."

#: includes/mcp/role-operations.php:277
