msgstr "Negalite ištrinti savo vaidmens."

#: includes/mcp/role-operations.php:282
#: includes/roles/class/class-pp-roles-actions.php:648
msgid "The role could not be deleted."
msgstr "Nepavyko ištrinti vaidmens."

#: includes/mcp/role-operations.php:314
msgid "PublishPress Permissions is not active."
msgstr "PublishPress Permissions neaktyvus."

#: includes/mcp/role-operations.php:317
msgid "Only the main-site network administrator can configure new-site roles."
msgstr ""
"Tik pagrindinės svetainės tinklo administratorius gali konfigūruoti naujų "
