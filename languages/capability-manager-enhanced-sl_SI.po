#: includes/user-capabilities-view.php:87
msgid ""
"These include known capabilities WordPress grants through Super Admin "
"access, role assignments, and direct overrides."
msgstr ""
"To vključuje znane zmožnosti, ki jih WordPress omogoči prek dostopa super "
"skrbnika, dodeljenih vlog in neposrednih preglasitev."

#: includes/user-capabilities-view.php:89
msgid "These are the capabilities assigned to this user in WordPress."
msgstr "To so zmožnosti, dodeljene temu uporabniku v WordPressu."

#: includes/user-capabilities-view.php:93
msgid "This user has no granted capabilities."
msgstr "Temu uporabniku niso bile odobrene nobene zmožnosti."

