msgstr "Iskanje odobrenih zmožnosti ..."

#: includes/user-capabilities-view.php:108
msgid "Type to filter this capability list."
msgstr "Vnesite besedilo za filtriranje seznama zmožnosti."

#: includes/user-capabilities-view.php:116
