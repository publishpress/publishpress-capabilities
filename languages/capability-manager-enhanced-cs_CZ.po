msgstr ""
"Před použitím možností úprav specifických pro stav zapněte podporované "
"ovládání vlastního stavu."

#: includes/mcp/pro-settings-operations.php:85
msgid "Privacy settings require the active Permissions Pro status integration."
msgstr "Nastavení ochrany soukromí vyžadují aktivní integraci stavu Permissions Pro."

#: includes/mcp/pro-settings-operations.php:91
