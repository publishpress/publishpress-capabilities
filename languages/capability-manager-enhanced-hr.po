#: capsman-enhanced.php:5
#. Description of the plugin
msgid ""
"PublishPress Capabilities is the access control plugin for WordPress. You "
"can manage all your WordPress user roles, from Administrators to "
"Subscribers."
msgstr ""
"PublishPress Capabilities dodatak je za kontrolu pristupa za WordPress. "
"Možete upravljati svim korisničkim ulogama u WordPressu, od administratora "
"do pretplatnika."

