msgstr "Acerca de las capacidades de PublishPress"

#: includes/manager.php:1740
msgid "About"
msgstr "Acerca de"

#: includes/manager.php:1742
msgid "Capabilites Documentation"
msgstr "Documentación de capacidades"

#: includes/manager.php:1742
