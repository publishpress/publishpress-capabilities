msgstr "Pridajte do panela admina možnosť vyhľadávania a testovania používateľov."

#: includes/settings-ui.php:226
msgid "Front End footer notice"
msgstr "Oznámenie v pätičke frontendu"

#: includes/settings-ui.php:231
