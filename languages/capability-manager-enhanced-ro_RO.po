#: includes/user-capabilities-view.php:143
msgid ""
"These entries are stored directly on the user account instead of coming "
"from a role."
msgstr ""
"Aceste înregistrări sunt stocate direct pe contul utilizatorului în loc să "
"provină dintr-un rol."

#: includes/user-capabilities-view.php:173
msgid ""
"These are permissions assigned to the user in the PublishPress Permissions "
"plugin."
msgstr ""
"Acestea sunt permisiunile atribuite utilizatorului în pluginul PublishPress "
"Permissions."

#: includes/user-capabilities-view.php:179
#: includes/user-capabilities-view.php:240
#, php-format
msgid "Extra Roles (%d)"
msgstr "Roluri suplimentare (%d)"

#: includes/user-capabilities-view.php:186
msgid "This user has no direct extra roles."
msgstr "Acest utilizator nu are roluri suplimentare directe."

#: includes/user-capabilities-view.php:201
#: includes/user-capabilities-view.php:248
#, php-format
msgid "Specific Permissions (%d)"
msgstr "Permisiuni specifice (%d)"

#: includes/user-capabilities-view.php:208
msgid "This user has no direct specific permissions."
msgstr "Acest utilizator nu are permisiuni specifice directe."

#: includes/user-capabilities-view.php:223
#: includes/user-capabilities-view.php:259
#, php-format
msgid ""
"Showing the first 50 of %d permissions. Use the Permissions editor to view "
"the full list."
msgstr ""
"Afișând primele 50 din %d permisiuni. Folosește editorul de permisiuni "
"pentru a vedea lista completă."

#: includes/user-capabilities-view.php:231
msgid "Inherited Group Permissions"
msgstr "Permisiuni de grup moștenite"

#: includes/user-capabilities-view.php:232
msgid ""
"Extra roles and specific permissions assigned to this user's active groups, "
"including WordPress role groups. These assignments are managed on the group."
msgstr ""
"Rolurile suplimentare și permisiunile specifice atribuite grupurilor active "
"ale acestui utilizator, inclusiv grupurilor de roluri WordPress. Aceste "
"atribuiri sunt gestionate la nivelul grupului."

#: includes/user-capabilities-view.php:234
msgid "This user has no group-assigned extra roles or specific permissions."
msgstr ""
"Acest utilizator nu are roluri suplimentare sau permisiuni specifice "
"atribuite grupurilor."

#: includes/user-capabilities-view.php:270
msgid "View Extra Roles"
msgstr "Vizualizați rolurile suplimentare"

#: includes/user-capabilities-view.php:275
msgid "View Specific Permissions"
msgstr "Vizualizați permisiunile specifice"

#: includes/user-role-assignment.php:36
msgid "You cannot change roles for this user."
msgstr "Nu puteți schimba rolurile acestui utilizator."

#: includes/user-role-assignment.php:50
msgid "Choose existing roles that you are allowed to assign."
msgstr "Alegeți rolurile existente pe care aveți permisiunea să le atribuiți."

#: includes/user-role-assignment.php:55
msgid "A disabled role cannot be assigned."
msgstr "Un rol dezactivat nu poate fi atribuit."

#: includes/user-role-assignment.php:59
msgid "You cannot remove your own roles through this action."
msgstr "Nu vă puteți elimina propriile roluri prin această acțiune."

